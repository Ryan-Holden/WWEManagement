@model WWEManagement.Data.Models.WrestlerDetails

@{
    ViewData["Title"] = "Delete Wrestler";
}

<div class="mb-4">
    <h1 class="mb-1">Delete Wrestler</h1>

    <p class="text-muted mb-0">
        Review the wrestler information before confirming this deletion.
    </p>
</div>

<div class="alert alert-danger">
    <strong>Warning:</strong>
    Deleting this wrestler will also delete the associated employee record.
</div>

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">
                Name
            </dt>
            <dd class="col-sm-9">
                @Model.FirstName @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Ring Name
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Model.RingName
            </dd>

            <dt class="col-sm-3">
                Weight Class
            </dt>
            <dd class="col-sm-9">
                @(Model.WeightClass ?? "Not specified")
            </dd>

            <dt class="col-sm-3">
                Hire Date
            </dt>
            <dd class="col-sm-9">
                @Model.HireDate.ToString("MMM d, yyyy")
            </dd>

            <dt class="col-sm-3">
                Debut Date
            </dt>
            <dd class="col-sm-9">
                @(Model.DebutDate.HasValue
                    ? Model.DebutDate.Value.ToString("MMM d, yyyy")
                    : "Not specified")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<form asp-controller="Wrestlers"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.WrestlerId"
      method="post">

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-danger">
            Delete Wrestler
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.WrestlerId"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>