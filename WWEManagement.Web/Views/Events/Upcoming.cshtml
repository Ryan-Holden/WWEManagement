@model List<WWEManagement.Data.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Upcoming Events</h1>

        <p class="text-muted mb-0">
            View all scheduled WWE events that have not yet occurred.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        All Events
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        There are currently no upcoming events.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Venue</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var wrestlingEvent in Model)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">
                                @wrestlingEvent.EventName
                            </span>
                        </td>

                        <td>
                            @wrestlingEvent.EventDate.ToString(
                                "MMM d, yyyy h:mm tt")
                        </td>

                        <td>
                            @wrestlingEvent.Venue
                        </td>

                        <td>
                            @wrestlingEvent.City

                            @if (!string.IsNullOrWhiteSpace(
                                wrestlingEvent.State))
                            {
                                <text>, @wrestlingEvent.State</text>
                            }
                        </td>

                        <td>
                            @if (wrestlingEvent.Status == "Scheduled")
                            {
                                <span class="badge bg-primary">
                                    Scheduled
                                </span>
                            }
                            else if (wrestlingEvent.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (wrestlingEvent.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @wrestlingEvent.Status
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@wrestlingEvent.EventId"
                               class="btn btn-sm btn-primary">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@wrestlingEvent.EventId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}