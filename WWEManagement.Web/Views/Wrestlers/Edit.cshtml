@model WWEManagement.Web.ViewModels.EditWrestlerViewModel

@{
    ViewData["Title"] = "Edit Wrestler";
}

<div class="mb-4">
    <h1 class="mb-1">Edit Wrestler</h1>

    <p class="text-muted mb-0">
        Update both the wrestler profile and associated employee information.
    </p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row">
            <div class="col-lg-7 col-md-9">

                <form asp-controller="Wrestlers"
                      asp-action="Edit"
                      method="post">

                    <input type="hidden"
                           asp-for="WrestlerId" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <h4 class="mb-3">
                        Employee Information
                    </h4>

                    <div class="mb-3">
                        <label asp-for="FirstName"
                               class="form-label"></label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName"
                               class="form-label"></label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HireDate"
                               class="form-label"></label>

                        <input asp-for="HireDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="HireDate"
                              class="text-danger"></span>
                    </div>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Wrestler Information
                    </h4>

                    <div class="mb-3">
                        <label asp-for="RingName"
                               class="form-label"></label>

                        <input asp-for="RingName"
                               class="form-control" />

                        <span asp-validation-for="RingName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WeightClass"
                               class="form-label"></label>

                        <input asp-for="WeightClass"
                               class="form-control" />

                        <span asp-validation-for="WeightClass"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DebutDate"
                               class="form-label"></label>

                        <input asp-for="DebutDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DebutDate"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-warning">
                            Save Changes
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.WrestlerId"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}