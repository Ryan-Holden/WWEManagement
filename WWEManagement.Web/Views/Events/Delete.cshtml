@model WWEManagement.Data.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="mb-4">
    <h1 class="mb-1">Delete Event</h1>

    <p class="text-muted mb-0">
        Review the event information before confirming this deletion.
    </p>
</div>

<div class="alert alert-danger">
    <strong>Warning:</strong>
    Are you sure you want to delete this event?
</div>

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">
                Event
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Model.EventName
            </dd>

            <dt class="col-sm-3">
                Date
            </dt>
            <dd class="col-sm-9">
                @Model.EventDate.ToString("MMM d, yyyy h:mm tt")
            </dd>

            <dt class="col-sm-3">
                Venue
            </dt>
            <dd class="col-sm-9">
                @Model.Venue
            </dd>

            <dt class="col-sm-3">
                Location
            </dt>
            <dd class="col-sm-9">
                @Model.City

                @if (!string.IsNullOrWhiteSpace(Model.State))
                {
                    <text>, @Model.State</text>
                }
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @if (Model.Status == "Scheduled")
                {
                    <span class="badge bg-primary">
                        Scheduled
                    </span>
                }
                else if (Model.Status == "Completed")
                {
                    <span class="badge bg-success">
                        Completed
                    </span>
                }
                else if (Model.Status == "Cancelled")
                {
                    <span class="badge bg-danger">
                        Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<form asp-action="DeleteConfirmed"
      asp-route-id="@Model.EventId"
      method="post">

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-danger">
            Delete Event
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.EventId"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>