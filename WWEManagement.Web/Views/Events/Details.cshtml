@model WWEManagement.Data.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Event Details</h1>

        <p class="text-muted mb-0">
            View event schedule, location, and status information.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.EventId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.EventId"
           class="btn btn-danger">
            Delete
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">
                Event
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Model.EventName
            </dd>

            <dt class="col-sm-3">
                Date
            </dt>
            <dd class="col-sm-9">
                @Model.EventDate.ToString("MMM d, yyyy h:mm tt")
            </dd>

            <dt class="col-sm-3">
                Venue
            </dt>
            <dd class="col-sm-9">
                @Model.Venue
            </dd>

            <dt class="col-sm-3">
                Location
            </dt>
            <dd class="col-sm-9">
                @Model.City

                @if (!string.IsNullOrWhiteSpace(Model.State))
                {
                    <text>, @Model.State</text>
                }
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @if (Model.Status == "Scheduled")
                {
                    <span class="badge bg-primary">
                        Scheduled
                    </span>
                }
                else if (Model.Status == "Completed")
                {
                    <span class="badge bg-success">
                        Completed
                    </span>
                }
                else if (Model.Status == "Cancelled")
                {
                    <span class="badge bg-danger">
                        Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>
</div>