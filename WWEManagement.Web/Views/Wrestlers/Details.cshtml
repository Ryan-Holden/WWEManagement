@model WWEManagement.Data.Models.WrestlerDetails

@{
    ViewData["Title"] = "Wrestler Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Wrestler Details</h1>

        <p class="text-muted mb-0">
            View wrestler and associated employee information.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Wrestlers"
           asp-action="Edit"
           asp-route-id="@Model.WrestlerId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-controller="Wrestlers"
           asp-action="Delete"
           asp-route-id="@Model.WrestlerId"
           class="btn btn-danger">
            Delete
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">
                Wrestler ID
            </dt>
            <dd class="col-sm-9">
                @Model.WrestlerId
            </dd>

            <dt class="col-sm-3">
                Employee ID
            </dt>
            <dd class="col-sm-9">
                @Model.EmployeeId
            </dd>

            <dt class="col-sm-3">
                Name
            </dt>
            <dd class="col-sm-9">
                @Model.FirstName @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Ring Name
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Model.RingName
            </dd>

            <dt class="col-sm-3">
                Job Title
            </dt>
            <dd class="col-sm-9">
                @Model.JobTitle
            </dd>

            <dt class="col-sm-3">
                Weight Class
            </dt>
            <dd class="col-sm-9">
                @(Model.WeightClass ?? "Not specified")
            </dd>

            <dt class="col-sm-3">
                Hire Date
            </dt>
            <dd class="col-sm-9">
                @Model.HireDate.ToString("MMM d, yyyy")
            </dd>

            <dt class="col-sm-3">
                Debut Date
            </dt>
            <dd class="col-sm-9">
                @(Model.DebutDate.HasValue
                    ? Model.DebutDate.Value.ToString("MMM d, yyyy")
                    : "Not specified")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Wrestlers"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Wrestlers
    </a>
</div>