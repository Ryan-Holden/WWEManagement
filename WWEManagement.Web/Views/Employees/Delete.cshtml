@model WWEManagement.Data.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="mb-4">
    <h1 class="mb-1">Delete Employee</h1>

    <p class="text-muted mb-0">
        Review the employee information before confirming this deletion.
    </p>
</div>

<div class="alert alert-danger">
    <strong>Warning:</strong>
    Are you sure you want to delete this employee?
</div>

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">
                Employee ID
            </dt>
            <dd class="col-sm-9">
                @Model.EmployeeId
            </dd>

            <dt class="col-sm-3">
                Name
            </dt>
            <dd class="col-sm-9 fw-semibold">
                @Model.FirstName @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Job Title
            </dt>
            <dd class="col-sm-9">
                @Model.JobTitle
            </dd>

            <dt class="col-sm-3">
                Hire Date
            </dt>
            <dd class="col-sm-9">
                @Model.HireDate.ToString("MMM d, yyyy")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </dd>

        </dl>
    </div>
</div>

<form asp-controller="Employees"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.EmployeeId"
      method="post">

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-danger">
            Delete Employee
        </button>

        <a asp-controller="Employees"
           asp-action="Details"
           asp-route-id="@Model.EmployeeId"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>